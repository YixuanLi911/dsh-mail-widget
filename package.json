{
  "name": "dsh-plugin-mail-widget",
  "version": "0.1.2",
  "description": "在 DeepSeek Harness 里看未读邮件：近 7 天 / 近一个月的未读邮件与发件人，提供挂件页面和两个 agent 工具，跨平台 IMAP。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "mail",
    "imap",
    "unread"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YixuanLi911/dsh-mail-widget.git"
  },
  "homepage": "https://github.com/YixuanLi911/dsh-mail-widget#readme",
  "bugs": {
    "url": "https://github.com/YixuanLi911/dsh-mail-widget/issues"
  }
}
